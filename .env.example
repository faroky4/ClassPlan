# اتصال قاعدة البيانات عبر Connection Pooling (Supabase: منفذ 6543 مع pgbouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# اتصال مباشر بقاعدة البيانات (يُستخدم من Prisma فقط لأجل الـ migrations، منفذ 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth.js (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="غيّر هذه القيمة بمفتاح عشوائي طويل - openssl rand -base64 32"
